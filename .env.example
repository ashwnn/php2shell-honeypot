# Local validation first. Set BIND_ADDRESS=0.0.0.0 on the isolated public VM.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# This is attacker SSH. Leave the host's real management SSH on its own port.
SSH_PORT=2222
HTTP_QUOTA_MIB=4096
# Optional image override; default is an inspected, pinned Cowrie 3.1.3 digest.
# COWRIE_IMAGE=cowrie/cowrie:3.1.3@sha256:69e3317c6ecf8811d18faecb8a2fcedee0af1f0f864b50de07b688c7409f515c
