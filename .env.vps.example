# Dedicated public IPv4 VPS only. The host's real SSH must use a different,
# verified management port before the decoy is started on 22. See docs/VPS.md.
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTP_ALT_PORT=8080
PUBLIC_SSH_PORT=22
PUBLIC_SSH_ALT_PORT=2222
PUBLIC_TELNET_PORT=23
HTTP_QUOTA_MIB=4096
# Optional: add -f compose.https.yaml after the public file. Provision TLS first.
# TLS_DIRECTORY=./tls
# PUBLIC_HTTPS_PORT=443
# PUBLIC_HTTPS_ALT_PORT=8443
